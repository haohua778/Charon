{
  "rubric_id": "program_evaluation",
  "analysis_type": "program_evaluation",
  "variant": "vague",
  "version": "0.1-draft",
  "dimensions": [
    {
      "dimension_id": "problem_definition",
      "name": "Problem definition",
      "checks": [
        {
          "check_id": "question_stated",
          "kind": "model_assessed",
          "scope": "document",
          "severity": "medium",
          "description": "Question stated.",
          "questions": [
            {
              "field": "question_stated",
              "type": "bool",
              "ask": "Assess question stated.",
              "quote_required_when": [
                true
              ]
            }
          ],
          "anchor_field": "question_stated",
          "flag_when": {
            "question_stated": [
              false
            ]
          },
          "reason_template": "An explicit business question or decision is stated: {question_stated}.",
          "tools": [],
          "examples": [
            {
              "text": "Revenue was 1.2M. Costs were 0.8M.",
              "flag": true,
              "why": "Review concern present."
            },
            {
              "text": "We assess whether to expand the pilot to all stores.",
              "flag": false,
              "why": "Review concern absent."
            }
          ]
        },
        {
          "check_id": "metric_defined",
          "kind": "model_assessed",
          "scope": "claim",
          "severity": "medium",
          "description": "Metric defined.",
          "questions": [
            {
              "field": "metric_used",
              "type": "bool",
              "ask": "Assess metric used.",
              "quote_required_when": [
                true
              ]
            },
            {
              "field": "definition_complete",
              "type": "bool",
              "ask": "Assess definition complete.",
              "quote_required_when": [
                true
              ]
            }
          ],
          "anchor_field": "metric_used",
          "flag_when": {
            "metric_used": [
              true
            ],
            "definition_complete": [
              false
            ]
          },
          "reason_template": "Metric \"{metric_used.quote}\" has a complete definition, time window, and population: {definition_complete}.",
          "tools": [],
          "examples": [
            {
              "text": "Engagement increased by 15%.",
              "flag": true,
              "why": "Review concern present."
            },
            {
              "text": "Weekly engagement, the share of active app users opening the app at least twice, rose to 45% in Q3.",
              "flag": false,
              "why": "Review concern absent."
            }
          ]
        },
        {
          "check_id": "metric_matches_standard",
          "kind": "needs_standard",
          "scope": "claim",
          "description": "Metric matches standard.",
          "pending_question": "What is EJ's official definition of this metric?"
        }
      ]
    },
    {
      "dimension_id": "data_selection",
      "name": "Data selection",
      "checks": [
        {
          "check_id": "data_disclosed",
          "kind": "model_assessed",
          "scope": "document",
          "severity": "medium",
          "description": "Data disclosed.",
          "questions": [
            {
              "field": "disclosure_complete",
              "type": "bool",
              "ask": "Assess disclosure complete.",
              "quote_required_when": [
                true
              ]
            }
          ],
          "anchor_field": "disclosure_complete",
          "flag_when": {
            "disclosure_complete": [
              false
            ]
          },
          "reason_template": "Data source, sample size, and time range are all disclosed: {disclosure_complete}.",
          "tools": [],
          "examples": [
            {
              "text": "Our survey shows higher satisfaction.",
              "flag": true,
              "why": "Review concern present."
            },
            {
              "text": "We analyzed 320 responses from the July 2025 customer survey.",
              "flag": false,
              "why": "Review concern absent."
            }
          ]
        },
        {
          "check_id": "selection_bias",
          "kind": "model_assessed",
          "scope": "claim",
          "severity": "high",
          "description": "Selection bias.",
          "questions": [
            {
              "field": "voluntary_comparison",
              "type": "bool",
              "ask": "Assess voluntary comparison.",
              "quote_required_when": [
                true
              ]
            },
            {
              "field": "selection_addressed",
              "type": "bool",
              "ask": "Assess selection addressed.",
              "quote_required_when": [
                true
              ]
            }
          ],
          "anchor_field": "voluntary_comparison",
          "flag_when": {
            "voluntary_comparison": [
              true
            ],
            "selection_addressed": [
              false
            ]
          },
          "reason_template": "Voluntary-participant comparison \"{voluntary_comparison.quote}\" addresses self-selection: {selection_addressed}.",
          "tools": [],
          "examples": [
            {
              "text": "Employees who volunteered for training sold more than those who did not, proving the program works.",
              "flag": true,
              "why": "Review concern present."
            },
            {
              "text": "Volunteers sold more, but their prior motivation may explain the difference, so we cannot attribute it to training.",
              "flag": false,
              "why": "Review concern absent."
            }
          ]
        }
      ]
    },
    {
      "dimension_id": "interpretation",
      "name": "Interpretation of results",
      "checks": [
        {
          "check_id": "causal_language",
          "kind": "model_assessed",
          "scope": "claim",
          "severity": "high",
          "description": "Causal language.",
          "questions": [
            {
              "field": "causal_wording",
              "type": "bool",
              "ask": "Assess causal wording.",
              "quote_required_when": [
                true
              ]
            },
            {
              "field": "comparison",
              "type": "enum",
              "ask": "Assess comparison.",
              "quote_required_when": [
                "before_after_only",
                "control_group",
                "randomized",
                "other"
              ],
              "values": [
                "none",
                "before_after_only",
                "control_group",
                "randomized",
                "other"
              ]
            }
          ],
          "anchor_field": "causal_wording",
          "flag_when": {
            "causal_wording": [
              true
            ],
            "comparison": [
              "none",
              "before_after_only"
            ]
          },
          "reason_template": "Causal wording \"{causal_wording.quote}\" is supported only by: {comparison}.",
          "tools": [],
          "examples": [
            {
              "text": "The new training raised output by 12%.",
              "flag": true,
              "why": "Review concern present."
            },
            {
              "text": "Output rose 12% versus a matched control site.",
              "flag": false,
              "why": "Review concern absent."
            }
          ]
        },
        {
          "check_id": "overclaim_small_diff",
          "kind": "model_assessed",
          "scope": "claim",
          "severity": "medium",
          "description": "Overclaim small diff.",
          "questions": [
            {
              "field": "significance_claimed",
              "type": "bool",
              "ask": "Assess significance claimed.",
              "quote_required_when": [
                true
              ]
            },
            {
              "field": "uncertainty_explained",
              "type": "bool",
              "ask": "Assess uncertainty explained.",
              "quote_required_when": [
                true
              ]
            }
          ],
          "anchor_field": "significance_claimed",
          "flag_when": {
            "significance_claimed": [
              true
            ],
            "uncertainty_explained": [
              false
            ]
          },
          "reason_template": "Significance wording \"{significance_claimed.quote}\" includes supporting uncertainty or significance evidence: {uncertainty_explained}.",
          "tools": [
            "calculator"
          ],
          "examples": [
            {
              "text": "A 0.1-point increase is a decisive improvement.",
              "flag": true,
              "why": "Review concern present."
            },
            {
              "text": "The difference was 0.1 points, with a 95% confidence interval from -0.2 to 0.4, so improvement is uncertain.",
              "flag": false,
              "why": "Review concern absent."
            }
          ]
        },
        {
          "check_id": "arithmetic_mismatch",
          "kind": "code",
          "scope": "claim",
          "severity": "high",
          "description": "Arithmetic mismatch.",
          "detector": "arithmetic_equation"
        },
        {
          "check_id": "percent_change_mismatch",
          "kind": "code",
          "scope": "claim",
          "severity": "high",
          "description": "Percent change mismatch.",
          "detector": "percent_change"
        },
        {
          "check_id": "missing_reference",
          "kind": "code",
          "scope": "claim",
          "severity": "medium",
          "description": "Missing reference.",
          "detector": "missing_reference"
        },
        {
          "check_id": "units_missing",
          "kind": "model_assessed",
          "scope": "claim",
          "severity": "low",
          "description": "Units missing.",
          "questions": [
            {
              "field": "number_used",
              "type": "bool",
              "ask": "Assess number used.",
              "quote_required_when": [
                true
              ]
            },
            {
              "field": "context_complete",
              "type": "bool",
              "ask": "Assess context complete.",
              "quote_required_when": [
                true
              ]
            }
          ],
          "anchor_field": "number_used",
          "flag_when": {
            "number_used": [
              true
            ],
            "context_complete": [
              false
            ]
          },
          "reason_template": "Number \"{number_used.quote}\" has sufficient units, period, and base: {context_complete}.",
          "tools": [],
          "examples": [
            {
              "text": "The rate reached 20.",
              "flag": true,
              "why": "Review concern present."
            },
            {
              "text": "In Q3, 20% of the 500 active accounts renewed.",
              "flag": false,
              "why": "Review concern absent."
            }
          ]
        }
      ]
    },
    {
      "dimension_id": "business_translation",
      "name": "Business translation",
      "checks": [
        {
          "check_id": "recommendation_traceable",
          "kind": "model_assessed",
          "scope": "claim",
          "severity": "medium",
          "description": "Recommendation traceable.",
          "questions": [
            {
              "field": "recommendation_made",
              "type": "bool",
              "ask": "Assess recommendation made.",
              "quote_required_when": [
                true
              ]
            },
            {
              "field": "finding_supports",
              "type": "bool",
              "ask": "Assess finding supports.",
              "quote_required_when": [
                true
              ]
            }
          ],
          "anchor_field": "recommendation_made",
          "flag_when": {
            "recommendation_made": [
              true
            ],
            "finding_supports": [
              false
            ]
          },
          "reason_template": "Recommendation \"{recommendation_made.quote}\" is traceable to a reported finding: {finding_supports}.",
          "tools": [],
          "examples": [
            {
              "text": "We should double the advertising budget.",
              "flag": true,
              "why": "Review concern present."
            },
            {
              "text": "Because the pilot reduced processing delays, extend it to the other two sites.",
              "flag": false,
              "why": "Review concern absent."
            }
          ]
        },
        {
          "check_id": "unsupported_guarantee",
          "kind": "model_assessed",
          "scope": "claim",
          "severity": "medium",
          "description": "Unsupported guarantee.",
          "questions": [
            {
              "field": "guarantee_wording",
              "type": "bool",
              "ask": "Assess guarantee wording.",
              "quote_required_when": [
                true
              ]
            },
            {
              "field": "grounds_present",
              "type": "bool",
              "ask": "Assess grounds present.",
              "quote_required_when": [
                true
              ]
            }
          ],
          "anchor_field": "guarantee_wording",
          "flag_when": {
            "guarantee_wording": [
              true
            ],
            "grounds_present": [
              false
            ]
          },
          "reason_template": "Future certainty \"{guarantee_wording.quote}\" has supporting grounds in the report: {grounds_present}.",
          "tools": [],
          "examples": [
            {
              "text": "This initiative guarantees that revenue will double next year.",
              "flag": true,
              "why": "Review concern present."
            },
            {
              "text": "We expect higher revenue if adoption reaches 60%, but the outcome remains uncertain.",
              "flag": false,
              "why": "Review concern absent."
            }
          ]
        },
        {
          "check_id": "assumptions_disclosed",
          "kind": "model_assessed",
          "scope": "document",
          "severity": "medium",
          "description": "Assumptions disclosed.",
          "questions": [
            {
              "field": "forecast_or_plan",
              "type": "bool",
              "ask": "Assess forecast or plan.",
              "quote_required_when": [
                true
              ]
            },
            {
              "field": "assumptions_disclosed",
              "type": "bool",
              "ask": "Assess assumptions disclosed.",
              "quote_required_when": [
                true
              ]
            }
          ],
          "anchor_field": "forecast_or_plan",
          "flag_when": {
            "forecast_or_plan": [
              true
            ],
            "assumptions_disclosed": [
              false
            ]
          },
          "reason_template": "Forecast or plan \"{forecast_or_plan.quote}\" discloses its material assumptions: {assumptions_disclosed}.",
          "tools": [],
          "examples": [
            {
              "text": "The plan projects 25% growth next year.",
              "flag": true,
              "why": "Review concern present."
            },
            {
              "text": "The plan projects 25% growth if demand rises 10% and the second site opens in June.",
              "flag": false,
              "why": "Review concern absent."
            }
          ]
        },
        {
          "check_id": "escalation_required",
          "kind": "needs_standard",
          "scope": "document",
          "description": "Escalation required.",
          "pending_question": "What is the EJ escalation process and which thresholds apply to this review?"
        }
      ]
    }
  ]
}
