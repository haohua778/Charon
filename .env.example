# OpenAI-compatible provider; never commit a real key.
KIMI_API_KEY='replace-with-your-key'
KIMI_BASE_URL='https://api.moonshot.cn/v1'
KIMI_MODEL='kimi-k2.6'
# Safe default: no live calls. Offline mode uses a synthetic fixture, not an LLM.
CHARON_ALLOW_LIVE=false
CHARON_OFFLINE=false
CHARON_TIMEOUT_SECONDS=45
CHARON_MAX_CALLS=80
CHARON_MAX_RETRIES=1
CHARON_MAX_OUTPUT_TOKENS=4096
# Document parsing runs the MinerU checkout in its own environment, never as a project dependency.
# Default: ../MinerU/MinerU/.venv/bin/python scripts/mineru_text_parse.py (relative to this project).
# MINERU_COMMAND='/path/to/MinerU/.venv/bin/python /path/to/Charon_agent/scripts/mineru_text_parse.py'
# MINERU_BACKEND='pipeline'
# MINERU_PARSE_METHOD='txt'   # txt = embedded text only; auto adds OCR for scanned pages
# PARSE_TIMEOUT_SECONDS=600
# MAX_DOCUMENT_BYTES=20000000
# Optional local operator paths; never accepted from /review requests.
# RECORDS_DIR='/absolute/path/to/local/records'
# RUBRICS_DIR='/absolute/path/to/rubrics'
